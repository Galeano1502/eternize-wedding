rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /weddings/{weddingId} {
      allow read, write: if request.auth != null && request.auth.uid == weddingId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == weddingId;
      }
    }
  }
}
